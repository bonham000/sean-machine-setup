#
# You are currently running on: MAC MINI (mac-mini)
#
# Role: Remote machine — usually operated via SSH.
# Purpose: For longer running or remote tasks such as longform video
#          recordings, AFK CC tasks, and remote agent tooling (e.g.
#          priori-tools).

MACHINE_ID=mac-mini
MACHINE_LABEL="Mac Mini"
MACHINE_ROLE="Remote machine — usually operated via SSH."
