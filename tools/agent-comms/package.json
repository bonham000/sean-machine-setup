{
  "name": "@sean-machine-setup/agent-comms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-comms": "./src/cli/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "discover": "bun src/session/discover.ts",
    "install-daemon": "bun scripts/install.ts",
    "uninstall-daemon": "bun scripts/uninstall.ts",
    "check": "bun run typecheck && bun test",
