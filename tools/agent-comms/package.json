    "test": "bun test",
    "build": "bun build src/index.ts --target=bun --outdir=dist"
  },
  "dependencies": {
    "@slack/bolt": "4.7.2",
    "hono": "4.12.30"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  }
}
