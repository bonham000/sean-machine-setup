<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.priori.agent-comms</string>

  <key>ProgramArguments</key>
  <array>
    <string>{BUN_PATH}</string>
    <string>{HOME}/.claude/agent-comms/dist/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{HOME}/.claude/agent-comms</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{HOME}</string>
    <key>PATH</key>
    <string>{HOME}/.local/bin:{HOME}/.bun/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>USER</key>
    <string>{USER}</string>
    <key>LOGNAME</key>
    <string>{USER}</string>
    <key>SHELL</key>
    <string>{SHELL}</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>LC_ALL</key>
    <string>en_US.UTF-8</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Minimum seconds between spawns. The daemon exits on its own when the
       Socket Mode client is wedged; without a floor, launchd relaunches ~10s
       later and a sustained outage becomes a restart storm. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>{HOME}/.claude/agent-comms/logs/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>{HOME}/.claude/agent-comms/logs/stderr.log</string>
</dict>
</plist>

